# ============================================================================
# AdmitionWala SMS & Email Configuration File
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# Do NOT commit this file to version control with real credentials
# ============================================================================

# ============================================================================
# SMS SERVICE CONFIGURATION
# ============================================================================
# Choose one: 'mock' (testing), 'fast2sms', 'twilio', 'aws_sns'
SMS_SERVICE=mock

# ============================================================================
# Fast2SMS Configuration (RECOMMENDED FOR INDIA)
# ============================================================================
# Free SMS API for India
# Website: https://www.fast2sms.com/
# Sign up and get your API key from the dashboard
# Features: Free tier (100 SMS/month), Instant OTP delivery, India-focused
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ============================================================================
# Twilio Configuration (GLOBAL)
# ============================================================================
# Cloud communications platform (SMS, Voice, Video)
# Website: https://www.twilio.com/
# Get credentials from: https://console.twilio.com/
# Features: Global coverage, 1000+ countries, paid service
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# ============================================================================
# AWS SNS Configuration (GLOBAL)
# ============================================================================
# Amazon's Simple Notification Service
# Website: https://aws.amazon.com/sns/
# Get credentials from: https://console.aws.amazon.com/
# Features: Scalable, reliable, integrated with AWS ecosystem
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_SNS_REGION=us-east-1

# ============================================================================
# OTP CONFIGURATION
# ============================================================================
# OTP expiration time in minutes
OTP_EXPIRY_MINUTES=10

# Maximum number of OTP verification attempts
OTP_MAX_ATTEMPTS=5

# Length of OTP code (digits)
OTP_CODE_LENGTH=6

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Email backend (console, smtp, sendgrid, etc.)
# For development: 'django.core.mail.backends.console.EmailBackend'
# For production: 'django.core.mail.backends.smtp.EmailBackend'
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Configuration (for Gmail, Custom SMTP, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# From address for emails
DEFAULT_FROM_EMAIL=noreply@admitionwala.com

# ============================================================================
# INSTRUCTIONS FOR EACH SERVICE
# ============================================================================

# FAST2SMS (Recommended for India)
# ========================
# 1. Go to https://www.fast2sms.com/
# 2. Sign up with your email and phone number
# 3. Get free 100 SMS/month on trial
# 4. Go to Account Settings > API key
# 5. Copy your API key and paste here
# 6. Set SMS_SERVICE=fast2sms
#
# Message format:
#   "Your AdmitionWala OTP is: 123456. Valid for 10 minutes."
#
# Benefits:
#   ✓ Free 100 SMS/month (trial)
#   ✓ India-focused, instant delivery
#   ✓ Low cost (~0.50/SMS after trial)
#   ✓ Easy setup, no credit card needed initially
#
# Rate Limits: 1 SMS/second per account


# TWILIO
# ======
# 1. Go to https://www.twilio.com/
# 2. Sign up and verify your identity
# 3. Get free $15 trial credits
# 4. Dashboard: https://console.twilio.com/
# 5. Copy Account SID, Auth Token, and Phone Number
# 6. Set all TWILIO_* variables
# 7. Set SMS_SERVICE=twilio
#
# Message format:
#   "Your AdmitionWala OTP is: 123456. Valid for 10 minutes."
#
# Benefits:
#   ✓ Global coverage (1000+ countries)
#   ✓ Reliable, enterprise-grade
#   ✓ $0.0075 per SMS (after trial)
#   ✓ Also supports voice calls
#
# Rate Limits: 1 SMS/second per account


# AWS SNS
# =======
# 1. Go to https://aws.amazon.com/
# 2. Sign up and verify identity
# 3. Get free tier ($1/month SMS credits)
# 4. Go to IAM > Users > Create user with SNS permissions
# 5. Generate access key and secret key
# 6. Set AWS_* variables
# 7. Set SMS_SERVICE=aws_sns
#
# Message format:
#   "Your AdmitionWala OTP is: 123456. Valid for 10 minutes."
#
# Benefits:
#   ✓ Integrates with AWS ecosystem
#   ✓ Scalable, reliable
#   ✓ Pay-as-you-go pricing
#   ✓ Free tier includes SMS credits
#
# Rate Limits: Configurable per account


# MOCK (Testing Only)
# ===================
# Default service for development
# SMS messages are logged to console
# No API key needed
# Perfect for testing without sending real SMS
#
# How to use:
#   1. SMS_SERVICE=mock (default)
#   2. Run your app and test
#   3. Check console output for OTP codes
#   4. No real SMS sent


# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# Step 1: Create .env file
# Copy this file to .env in the project root:
#   cp .env.example .env

# Step 2: Choose your SMS service
# Uncomment your chosen service credentials in .env

# Step 3: Update .gitignore
# Make sure .env is in .gitignore (never commit real credentials!)
# Add this to .gitignore:
#   .env
#   *.env
#   .env.local
#   .env.*.local

# Step 4: Install python-decouple (if not already installed)
#   pip install python-decouple

# Step 5: Load .env in your settings
# Add to settings.py (already done):
#   from decouple import config
#   SMS_SERVICE = config('SMS_SERVICE', default='mock')

# Step 6: Test your configuration
# python manage.py shell
# from core.sms_service import SMSService
# result = SMSService.send('9226236200', 'Test OTP: 123456')
# print(result)

# Step 7: Deploy
# Set environment variables in your hosting platform:
#   - Heroku: heroku config:set SMS_SERVICE=fast2sms
#   - AWS: Use Systems Manager Parameter Store
#   - Docker: Use environment variables in docker-compose.yml
#   - Kubernetes: Use ConfigMaps and Secrets

